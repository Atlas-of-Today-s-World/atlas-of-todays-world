{
  "name": "atlas-today-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "start": "next start -p 3000",
    "data:geo": "node scripts/fetch-geodata.mjs",
    "data:all": "npm run data:geo && npm run data:optimise",
    "verify": "node scripts/verify-build.mjs",
    "data:optimise": "node scripts/optimise-geodata.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:db": "node --test supabase/tests/rls.test.mjs supabase/tests/seed.test.mjs supabase/tests/admin-queries.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:dup": "jscpd",
    "check:unused": "knip",
    "prepare": "husky",
    "check:audit": "audit-ci --config audit-ci.jsonc",
    "check:links": "node scripts/check-links.mjs",
    "db:types": "npx --yes supabase@2 gen types typescript --project-id $SUPABASE_DEV_PROJECT_REF --schema public > src/lib/db/types.gen.ts",
    "db:make-admin": "node scripts/db/make-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "audit-ci": "^7.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.1.14",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}

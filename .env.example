# Přihlášení k odběru novinek. Klíč má tvar `xxxx-us21`.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Veřejná adresa webu kvůli kanonickým odkazům a sitemapě. Jediné místo s doménou:
# přechod na atlasoftodaysworld.org = změna této proměnné (canonical, sitemap, feedy, llms.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Adresa a veřejný klíč smí do prohlížeče: bez přihlášení jimi jde jen číst
# zveřejněný obsah, všechno ostatní hlídá RLS v databázi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servisní klíč obchází RLS. JEN na serveru (importy, webhook plateb),
# nikdy s předponou NEXT_PUBLIC_, nikdy do gitu ani do chatu.
SUPABASE_SERVICE_ROLE_KEY=

# Klíč pro hashované IP adresy a e-maily v rate limitu (HMAC). JEN na serveru,
# aspoň 32 znaků, např. `openssl rand -hex 32`. Prázdné = dosavadní odvození
# klíčů; po nastavení začnou okna rate limitu jednou nanovo (neškodné).
RATE_LIMIT_SECRET=

# Cloudflare Turnstile. Veřejný klíč: přihlášení kódem e-mailem i veřejné formuláře.
# Tajný klíč JEN na serveru: s oběma klíči newsletter a přihláška dobrovolníka ukážou
# widget a server token ověří; bez tajného klíče formuláře fungují jako dřív.
# Lokálně jdou testovací klíče Cloudflare: 1x00000000000000000000AA (site key) a
# 1x0000000000000000000000000000000AA (secret, vždy projde).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Stripe (ADR G6, src/lib/stripe.ts) ---------------------------------------
# Obě tajné hodnoty JEN na serveru. S oběma otevře „Donate & Join" platební stránku
# Stripe Checkout a /api/stripe/webhook zapisuje členství; bez nich zůstane demo.
# Lokálně vždy testovací klíč (sk_test_…) a podpisový klíč ze `stripe listen
# --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Přihlašovací stránka zákaznického portálu (Stripe → Settings → Billing → Customer
# portal), https://billing.stripe.com/p/login/…; veřejná. Prázdné = jen kontakt.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# --- SEO & GEO (ADR-021) -------------------------------------------------------
# IndexNow (Bing → ChatGPT/Copilot, Seznam, Yandex): 8–128 znaků a-z A-Z 0-9 -, veřejný
# (servíruje se na /indexnow-key.txt). Prázdné = pingy vypnuté. Pinguje jen produkce.
INDEXNOW_KEY=
# Ověření vlastnictví v Google Search Console / Bing Webmaster / Seznam Webmaster
# (obsah atributu content z jejich <meta>); prázdné = ověření přes DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SEZNAM_SITE_VERIFICATION=

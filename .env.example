# Sdílené heslo do administrace. Bez něj je administrace v provozu zavřená
# (404) a lokálně otevřená. Dočasné řešení, než přijde Supabase Auth.
ADMIN_TOKEN=

# Chatbot nad obsahem Atlasu. Bez klíče se tváří jako vypnutý.
ANTHROPIC_API_KEY=

# Přihlášení k odběru novinek. Klíč má tvar `xxxx-us21`.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Veřejná adresa webu kvůli kanonickým odkazům a sitemapě.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

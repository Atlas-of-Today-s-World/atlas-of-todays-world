# Přihlášení k odběru novinek. Klíč má tvar `xxxx-us21`.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Kontakt provozovatele (zásady ochrany soukromí, přístupnost). Bez něj se odkazuje na GitHub.
NEXT_PUBLIC_CONTACT_EMAIL=

# Veřejná adresa webu kvůli kanonickým odkazům a sitemapě.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Adresa a veřejný klíč smí do prohlížeče: bez přihlášení jimi jde jen číst
# zveřejněný obsah, všechno ostatní hlídá RLS v databázi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servisní klíč obchází RLS. JEN na serveru (importy, webhook plateb),
# nikdy s předponou NEXT_PUBLIC_, nikdy do gitu ani do chatu.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (až přijde P10; nejdřív testovací režim) -------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PATRON=
NEXT_PUBLIC_STRIPE_PRICE_FOUNDING=
